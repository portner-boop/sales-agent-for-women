[
  {
    "id": "feedback-flirt-vilnius",
    "note": "Разговор 1 и пункты 3-6, 8 из замечаний клиента",
    "steps": [
      {
        "message": "hi Marko :)",
        "expect": {
          "greets": true,
          "not_contains": [
            "quiet-evening",
            "kind of guy"
          ]
        }
      },
      {
        "message": "hey handsome :) i saw your photo and couldnt resist to write",
        "expect": {
          "not_contains": [
            "charming way",
            "glad you did",
            "pretty good way"
          ]
        }
      },
      {
        "message": "only charming? i was hoping you would say something more about me ;)",
        "expect": {
          "not_contains": [
            "playful confidence",
            "hard not to flirt back"
          ]
        }
      },
      {
        "message": "i live in Vilnius, its already cold and dark here",
        "expect": {
          "not_contains": [
            "croatia sounds",
            "explore croatia",
            "visit croatia"
          ]
        }
      },
      {
        "message": "what's the time there?",
        "expect": {
          "mentions_time": true,
          "not_contains": [
            "in vilnius it"
          ]
        }
      },
      {
        "message": "what are you doing now?",
        "expect": {
          "not_contains": [
            "chatting with you",
            "texting with you",
            "talking to you",
            "here with you"
          ]
        }
      },
      {
        "wait_seconds": 70,
        "expect": {
          "followup": "no_self_answer"
        }
      },
      {
        "wait_seconds": 130,
        "expect": {
          "followup": "no_self_answer"
        }
      },
      {
        "message": "sorry was busy... what do you remember about me so far?",
        "expect": {
          "contains_any": [
            "vilnius"
          ]
        }
      }
    ]
  },
  {
